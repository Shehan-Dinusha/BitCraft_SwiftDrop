# Local-only frontend image: serves a dist/ already built on the host by
# scripts/k8s-local-build.sh (npm run build). The Helm chart mounts the nginx
# config from a ConfigMap. CD keeps using frontend/Dockerfile.
# Same non-root base as frontend/Dockerfile: UID 101, listening on 8080.
FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY dist /usr/share/nginx/html
USER 101
EXPOSE 8080
