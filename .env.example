# ──────────────────────────────────────────────────────────────────────────────
# SwiftDrop – Environment Variables Template
# Copy to `.env` and fill in real values. NEVER commit `.env` to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Global ───────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=swiftdrop
ENVIRONMENT=local

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=swiftdrop
RABBITMQ_DEFAULT_PASS=changeme_rabbit
RABBITMQ_ERLANG_COOKIE=SWIFTDROP_ERLANG_COOKIE_SECRET

# ─── PostgreSQL Credentials (shared pattern, per-service override possible) ──
POSTGRES_USER=swiftdrop
POSTGRES_PASSWORD=changeme_pg

# ─── IAM / Auth ──────────────────────────────────────────────────────────────
IAM_DB_HOST=iam-postgres
IAM_DB_PORT=5432
IAM_DB_NAME=swiftdrop_iam

# ─── Order Service ───────────────────────────────────────────────────────────
ORDER_DB_HOST=order-postgres
ORDER_DB_PORT=5432
ORDER_DB_NAME=swiftdrop_order

# ─── Pricing Service ────────────────────────────────────────────────────────
PRICING_DB_HOST=pricing-postgres
PRICING_DB_PORT=5432
PRICING_DB_NAME=swiftdrop_pricing

# ─── Dispatch Service ───────────────────────────────────────────────────────
DISPATCH_DB_HOST=dispatch-postgres
DISPATCH_DB_PORT=5432
DISPATCH_DB_NAME=swiftdrop_dispatch

# ─── Delivery Service ───────────────────────────────────────────────────────
DELIVERY_DB_HOST=delivery-postgres
DELIVERY_DB_PORT=5432
DELIVERY_DB_NAME=swiftdrop_delivery

# ─── Merchant Service ───────────────────────────────────────────────────────
MERCHANT_DB_HOST=merchant-postgres
MERCHANT_DB_PORT=5432
MERCHANT_DB_NAME=swiftdrop_merchant

# ─── Webhook Service ────────────────────────────────────────────────────────
WEBHOOK_DB_HOST=webhook-postgres
WEBHOOK_DB_PORT=5432
WEBHOOK_DB_NAME=swiftdrop_webhook

# ─── Notification Service ───────────────────────────────────────────────────
NOTIFY_DB_HOST=notify-postgres
NOTIFY_DB_PORT=5432
NOTIFY_DB_NAME=swiftdrop_notify

# ─── Analytics Service ──────────────────────────────────────────────────────
ANALYTICS_DB_HOST=analytics-postgres
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_NAME=swiftdrop_analytics

# ─── Azure Container Registry ───────────────────────────────────────────────
ACR_LOGIN_SERVER=swiftdropacr.azurecr.io
ACR_USERNAME=
ACR_PASSWORD=

# ─── Azure AKS ──────────────────────────────────────────────────────────────
AKS_CLUSTER_NAME=swiftdrop-aks
AKS_RESOURCE_GROUP=rg-swiftdrop-prod
AZURE_SUBSCRIPTION_ID=

# ─── JWT / Security ─────────────────────────────────────────────────────────
JWT_SECRET=changeme_jwt_secret_256bit
JWT_EXPIRATION_MS=3600000

# ─── Observability ──────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
APPLICATIONINSIGHTS_CONNECTION_STRING=
