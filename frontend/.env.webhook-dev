# Local webhook development mode: loaded ONLY by `npm run dev:webhook` (vite --mode webhook-dev).
# Normal `npm run dev`, `npm run build` and the Docker/nginx frontend never read this file.
# See backend/webhook-resiliency-service/IMPLEMENTATION_PLAN.md, "Local development mode".

# Browser side: start with a fake MERCHANT dev session so route guards do not redirect to /login.
VITE_DEV_AUTH_BYPASS=true

# Dev-server side (not exposed to browser code): send /api/v1/webhooks/** directly to the webhook
# service and inject this fixed identity instead of the gateway. Target must be a loopback URL.
WEBHOOK_DEV_DIRECT=true
WEBHOOK_DEV_TARGET=http://localhost:8087
WEBHOOK_DEV_USER_ID=00000000-0000-4000-8000-0000000000d1
WEBHOOK_DEV_ROLE=MERCHANT
WEBHOOK_DEV_MERCHANT_ID=00000000-0000-4000-8000-0000000000a1
