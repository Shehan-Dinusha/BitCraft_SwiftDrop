# ─── Java / Maven ──────────────────────────────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
*.logs
.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties

# ─── Node / Frontend ──────────────────────────────────────────────────────────
node_modules/
dist/
dist-catalog/
.vite/
*.tsbuildinfo
.eslintcache
frontend/vite.config.js
frontend/vite.config.d.ts

# ─── IDE ──────────────────────────────────────────────────────────────────────
.idea/
*.iml
*.iws
.vscode/
*.swp
*.swo
*~

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Environment ──────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ─── Docker ───────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ─── Kubernetes Secrets (never commit) ────────────────────────────────────────
infra/helm/**/values-secrets*.yaml
!infra/helm/**/values-secrets.example.yaml
infra/**/secrets*.yml
infra/**/*.pem

# ─── Local RSA keys (generated by scripts/generate-rsa-keys.sh) ───────────────
secrets/
.secrets/
*.pem

# ─── Terraform ────────────────────────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
!*.tfvars.example

# ─── Logs & Misc ──────────────────────────────────────────────────────────────
*.log
*.pid
*.seed
coverage/
.nyc_output/

# Local Codex/Maven validation cache
.codex/maven-repository/

# Secret local application config (never commit to git)
**/application-secret.yml
**/application-secret.properties
