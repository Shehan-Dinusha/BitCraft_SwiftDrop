<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven settings for the image builds only (copied to /root/.m2/settings.xml by every
  backend Dockerfile; local and CI builds are unaffected).

  Why: CD builds 11 images in parallel on GitHub-hosted runners, and some runners repeatedly
  got "Could not find artifact ... spring-boot-starter-parent:pom:3.5.16 (absent)" from
  repo.maven.apache.org while the same file was served to the other runners (and returns
  200 when fetched directly). Retrying on the same runner did not help. Google's official
  mirror of Maven Central serves the identical artifacts from a different CDN.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <mirror>
      <id>google-maven-central</id>
      <name>Google Cloud mirror of Maven Central</name>
      <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
</settings>
